{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elementzero.sovrance/schemas/shell_challenge.schema.json",
  "title": "ElementZero EZ-B003 shell challenge manifest",
  "description": "The preregistered set of hidden-shell challenges of one snapshot. Every declared closure of the availability set appears exactly once, EVALUABLE with a mask or NOT_EVALUABLE with its reasons. A closure that fails the support rule is never omitted. The manifest carries identities, geometry, counts, and policies; any truth-bearing field is a leakage error.",
  "type": "object",
  "required": [
    "benchmark_id",
    "protocol_version",
    "challenge_policy_id",
    "mask_policy_id",
    "support_policy_id",
    "support_settings",
    "n_challenges",
    "n_evaluable",
    "n_not_evaluable",
    "challenges",
    "challenge_ids",
    "challenge_manifest_hash"
  ],
  "properties": {
    "benchmark_id": { "const": "EZ-B003" },
    "protocol_version": { "type": "string" },
    "challenge_policy_id": { "type": "string" },
    "mask_policy_id": { "type": "string" },
    "support_policy_id": { "type": "string" },
    "challenge_manifest_hash_rule": { "type": "string" },
    "support_settings": {
      "type": "object",
      "required": [
        "support_policy_id",
        "half_width",
        "MIN_CHAIN_LENGTH",
        "MIN_TARGETS",
        "MIN_EVALUABLE_CHAINS",
        "MIN_PEAK_CANDIDATES",
        "PEAK_WINDOW"
      ],
      "properties": {
        "support_policy_id": { "type": "string" },
        "mask_policy_id": { "type": "string" },
        "half_width": { "type": "integer", "minimum": 1 },
        "MIN_CHAIN_LENGTH": { "type": "integer", "minimum": 1 },
        "MIN_TARGETS": { "type": "integer", "minimum": 1 },
        "MIN_EVALUABLE_CHAINS": { "type": "integer", "minimum": 1 },
        "MIN_PEAK_CANDIDATES": { "type": "integer", "minimum": 1 },
        "PEAK_WINDOW": { "type": "integer", "minimum": 0 },
        "peak_parity_rule": { "type": "string" },
        "chain_rule": { "type": "string" },
        "span_rule": { "type": "string" },
        "closure_rule": { "type": "string" },
        "not_evaluable_rule": { "type": "string" },
        "availability_set": {
          "type": "object",
          "properties": {
            "neutron": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "proton": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
          }
        }
      }
    },
    "n_challenges": { "type": "integer", "minimum": 1 },
    "n_evaluable": { "type": "integer", "minimum": 0 },
    "n_not_evaluable": { "type": "integer", "minimum": 0 },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["challenge_id", "axis", "closure", "status", "mask"],
        "properties": {
          "challenge_id": { "type": "string", "pattern": "^(neutron-N|proton-Z)[0-9]+$" },
          "axis": { "enum": ["neutron", "proton"] },
          "closure": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["EVALUABLE", "NOT_EVALUABLE"] },
          "mask": {
            "oneOf": [
              { "$ref": "https://elementzero.sovrance/schemas/shell_mask.schema.json" },
              { "type": "null" }
            ]
          },
          "mask_id": { "type": ["string", "null"] },
          "indicator": { "enum": ["delta2n", "delta2p", null] },
          "n_targets": { "type": "integer", "minimum": 0 },
          "n_training": { "type": "integer", "minimum": 0 },
          "n_supported_chains": { "type": "integer", "minimum": 0 },
          "supported_chains": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "unsupported_chains": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "chain_support": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chain", "supported"],
              "properties": {
                "chain": { "type": "integer", "minimum": 0 },
                "n_masked_targets": { "type": "integer", "minimum": 0 },
                "n_window_training": { "type": "integer", "minimum": 0 },
                "lower_support": { "type": "boolean" },
                "upper_support": { "type": "boolean" },
                "closure_computable": { "type": "boolean" },
                "n_peak_candidates": { "type": "integer", "minimum": 0 },
                "supported": { "type": "boolean" },
                "reasons": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "reasons": { "type": "array", "items": { "type": "string" } }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "EVALUABLE" } } },
            "then": {
              "properties": {
                "mask": { "$ref": "https://elementzero.sovrance/schemas/shell_mask.schema.json" }
              },
              "required": ["mask_id", "indicator"]
            }
          }
        ]
      }
    },
    "challenge_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(neutron-N|proton-Z)[0-9]+$" }
    },
    "evaluable_challenge_ids": { "type": "array", "items": { "type": "string" } },
    "not_evaluable_challenge_ids": { "type": "array", "items": { "type": "string" } },
    "mask_ids": { "type": "array", "items": { "type": "string" } },
    "challenge_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "properties": {
        "edition_id": { "type": "string" },
        "raw_relpath": { "type": "string" },
        "raw_filename": { "type": "string" },
        "raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ground_truth_policy": { "type": "string" },
        "parser_version": { "type": "string" },
        "n_eligible": { "type": "integer", "minimum": 1 }
      }
    },
    "notes": { "type": "string" }
  },
  "not": {
    "anyOf": [
      { "required": ["mass_excess_keV"] },
      { "required": ["uncertainty_keV"] },
      { "required": ["binding_energy"] },
      { "required": ["truth"] }
    ]
  }
}
