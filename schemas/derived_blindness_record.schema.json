{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElementZero Derived Blindness Record",
  "type": "object",
  "required": [
    "derived_observable_id",
    "observable",
    "central_nuclide_id",
    "component_nuclide_ids",
    "component_model_claim_types",
    "truth_dependency_ids",
    "model_dependency_ids",
    "all_model_inputs_blind_eligible",
    "claim_type",
    "full_shell_gate_eligible",
    "reason"
  ],
  "properties": {
    "derived_observable_id": {
      "type": "string"
    },
    "observable": {
      "enum": [
        "S2n",
        "S2p",
        "delta2n",
        "delta2p",
        "local_peak_rank"
      ]
    },
    "central_nuclide_id": {
      "type": "string"
    },
    "component_nuclide_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "component_model_claim_types": {
      "type": "object"
    },
    "truth_dependency_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_dependency_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "all_model_inputs_blind_eligible": {
      "type": "boolean"
    },
    "claim_type": {
      "type": "string"
    },
    "full_shell_gate_eligible": {
      "type": "boolean"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
