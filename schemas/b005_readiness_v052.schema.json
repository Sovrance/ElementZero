{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "result",
    "qualifying_blind_physics_families",
    "wo16_gate",
    "family_results"
  ],
  "properties": {
    "result": {
      "enum": [
        "CALIBRATED_MULTI_FAMILY_BLIND_PASS",
        "CALIBRATED_MULTI_FAMILY_BLIND_MIXED",
        "CALIBRATED_MULTI_FAMILY_BLIND_NOT_MET",
        "B005_NOT_EVALUABLE",
        "B005_INTEGRITY_FAILURE"
      ]
    },
    "qualifying_blind_physics_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wo16_gate": {
      "enum": [
        "OPEN",
        "CLOSED"
      ]
    },
    "family_results": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
