{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elementzero.sovrance/schemas/run_manifest.schema.json",
  "title": "ElementZero scientific run manifest",
  "type": "object",
  "required": [
    "benchmark_id",
    "protocol_version",
    "stage",
    "atlas_pir_ref",
    "elementzero_commit",
    "source_hashes",
    "normalizer_version",
    "parser_version",
    "ground_truth_policy",
    "feature_policy_id",
    "model_id",
    "predictive_distribution",
    "uncertainty_method",
    "training_dataset_fact_id",
    "knowledge_freeze_fact_id",
    "model_fit_fact_id",
    "prediction_fact_ids",
    "prediction_set_fact_id"
  ],
  "properties": {
    "benchmark_id": { "type": "string", "const": "EZ-B001" },
    "legacy_id": { "type": "string", "const": "ZME-B001" },
    "protocol_version": { "type": "string" },
    "stage": { "type": "string" },
    "run_id": { "type": "string" },
    "freeze_id": { "type": "string" },
    "model_id": { "type": "string" },
    "model_manifest_hash": { "type": "string" },
    "predictive_distribution": { "type": "string", "const": "gaussian" },
    "uncertainty_method": { "type": "string", "minLength": 1 },
    "target_ids": { "type": "array", "items": { "type": "string" } },
    "target_identity_digest": { "type": "string" },
    "observable": { "type": "string" },
    "library_versions": { "type": "object" },
    "random_seeds": { "type": "object" },
    "source_hashes": { "type": "array", "items": { "type": "string" } },
    "normalizer_version": { "type": "string" },
    "parser_version": { "type": "string" },
    "ground_truth_policy": { "type": "string" },
    "feature_policy_id": { "type": "string" },
    "predictions_file_hash": { "type": "string" },
    "certificates_file_hash": { "type": "string" },
    "training_dataset_fact_id": { "type": "string" },
    "knowledge_freeze_fact_id": { "type": "string" },
    "model_fit_fact_id": { "type": "string" },
    "prediction_fact_ids": { "type": "array", "items": { "type": "string" } },
    "prediction_set_fact_id": { "type": "string" },
    "atlas_bundle_hashes": {
      "type": "object",
      "description": "Atlas bundle file name -> sha256 of the persisted canonical JSON",
      "additionalProperties": { "type": "string" }
    },
    "atlas_repository": { "type": "string" },
    "atlas_pir_ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "elementzero_commit": { "type": "string" }
  }
}
