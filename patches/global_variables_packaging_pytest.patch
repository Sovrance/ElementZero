@@ -0,0 +1,19 @@
+"""Pytest bridge for the legacy script-style certified benchmark suite.
+
+The scientific benchmarks intentionally use t1_*/t2_* sequencing and are executed
+by ci.run_all_certified. This wrapper makes ordinary `python -m pytest` a supported
+entry point without changing benchmark semantics during the packaging migration.
+"""
+from pathlib import Path
+
+from ci.run_all_certified import run
+
+
+def test_certified_suite(tmp_path: Path):
+    manifest = run(str(tmp_path / "certified"), seed="0", verbose=False)
+    assert manifest["result"] == "PASS", [
+        b for b in manifest["benchmarks"] if not b.get("passed")
+    ]
+    assert manifest["any_failure"] is False
+    assert manifest["any_degradation"] is False
+    assert manifest["signature_sha256"]
